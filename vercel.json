{
  "name": "fundchain-frontend",
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/next"
    }
  ],
  "env": {
    "NEXT_PUBLIC_API_URL": "https://fundchain-backend.onrender.com",
    "NEXT_PUBLIC_APP_NAME": "FundChain",
    "NEXT_PUBLIC_APP_VERSION": "1.0.0"
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ],
  "functions": {
    "pages/api/**/*.js": {
      "runtime": "nodejs18.x"
    }
  }
}